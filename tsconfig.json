{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2023",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["node"],
        "strict": true,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": false,
        "resolveJsonModule": true,
        "outDir": "./dist"
    },
    "include": ["src/**/*", "rollup.config.ts"],
    "exclude": ["node_modules", "dist"]
}
