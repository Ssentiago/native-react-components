{
    "name": "@obsidian-lib/native-react-components",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.0.21",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@types/minimatch": "^6.0.0",
        "@types/node": "^24.0.14",
        "@types/react": "19.1.6",
        "@types/react-dom": "^18.3.1",
        "obsidian": "^1.8.7",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "rollup": "^4.44.0",
        "rollup-plugin-analyzer": "^4.0.0",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-delete": "^3.0.1",
        "rollup-plugin-dts": "^6.2.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "rollup-plugin-watch": "^1.0.5",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    },
    "packageManager": "bun@1.2.17",
    "dependencies": {},
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ssentiago/native-react-components.git"
    },
    "homepage": "https://github.com/Ssentiago/native-react-components#readme",
    "bugs": {
        "url": "https://github.com/Ssentiago/native-react-components/issues"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/*.tgz",
        "docs"
    ],
    "sideEffects": false
}
